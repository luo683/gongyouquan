# Backend image. Node 22 because the repo pins engines to >=22 <23 and the host
# dev machine runs 24 - this is the first place the project runs on its declared
# version.
#
# glibc (node:22-slim) rather than alpine on purpose: argon2 is a native module
# and shipping a musl build would mean compiling it in every image build.
FROM node:22-slim

# python3/make/g++ stay as a fallback so an argon2 version without a matching
# prebuild fails loudly during install instead of at first login.
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable

WORKDIR /app

# Manifests first so dependency installation is cached independently of source.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/contracts/package.json packages/contracts/
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/

# --frozen-lockfile is the same contract CI asserts: a package.json that drifts
# from the lockfile has to break the build, not silently install something else.
RUN pnpm install --frozen-lockfile

COPY packages/contracts packages/contracts
COPY apps/server apps/server
COPY infra/db infra/db

RUN pnpm --filter @gongyouquan/contracts build

ENV NODE_ENV=production \
    PORT=3000

# Migrations run at boot and the process refuses to become ready without a
# database - by design (docs/decisions/0002), so this is the only entrypoint.
CMD ["pnpm", "--filter", "@gongyouquan/server", "dev"]
