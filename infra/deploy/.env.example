# 工友圈 deploy stack - the five secrets below are deliberately EMPTY.
#
# Compose reads this directory's `.env` automatically (the project directory is
# the directory that holds the compose file), so the stack comes up with:
#
#   cp infra/deploy/.env.example infra/deploy/.env && infra/deploy/gen-secrets.sh
#
# Empty is not "unset so you might forget" - every secret in docker-compose.yml
# is a required interpolation (`VAR:?`), and that form rejects an empty value as
# well as a missing one. Copy this file and run `docker compose config` without
# generating secrets and it fails, naming each variable that is still blank.
#
# .gitignore already covers `.env` at every level; nothing here is a credential.

# ── Non-secret names ──
POSTGRES_USER=gongyouquan
POSTGRES_DB=gongyouquan

# ── Secrets: generated, never committed, never shared between purposes ──
# 手册 4.1 lists these five and says to generate them one at a time. One key
# doing two jobs means one leak gets both blast radii.

# Database password. Deliberately hex, not `openssl rand -base64`: this value is
# interpolated into DATABASE_URL, and the base64 alphabet contains `/` and `+`,
# which are URI delimiters. See docs/decisions/0012.
POSTGRES_PASSWORD=

# Access-token signing. base64 is safe here: it never enters a URL.
JWT_SECRET=

# Present only because apps/server validates MEILI_MASTER_KEY is non-empty; no
# meilisearch runs in this stack (its degraded path is PG pg_trgm). The value
# becomes real the day the service is added, instead of being a literal in git.
MEILI_MASTER_KEY=

# /hooks/* signature. Must not be shared with JWT_SECRET even though both HMAC.
ALERT_HMAC_SECRET=

# restic repository encryption. 丢了等于所有异地备份永久无法解密 - keep the
# generated value somewhere that is not this server.
RESTIC_PASSWORD=

# ── Optional ──
# Which group /hooks/alert posts into. Empty is a working stack: the endpoint
# answers 503 OPS_GROUP_NOT_CONFIGURED until this is set, which beats refusing to
# boot over an id only the alert path reads. To find it after the fact:
# create-admin has already made a #运维告警 group and printed the number, and it
# is `select id from groups where name = '#运维告警'`.
SYSTEM_GROUP_ID=

# Offsite target for the backup container (手册 8.1). Left empty, backup-once.sh
# refuses to run unless ALLOW_LOCAL_ONLY=1 says you mean it.
RESTIC_REPOSITORY=
