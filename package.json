{
  "name": "gongyouquan",
  "version": "0.1.0",
  "private": true,
  "description": "工友圈：群聊与群内任务协作系统",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "check:workspace": "pnpm --recursive list --depth -1",
    "pretest": "pnpm --filter @gongyouquan/contracts build",
    "test": "pnpm --recursive --if-present run test",
    "pretypecheck": "pnpm --filter @gongyouquan/contracts build",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "lint": "pnpm --recursive --if-present run lint"
  }
}
